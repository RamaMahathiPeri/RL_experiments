# Training the model 

log_path = os.path.join('Training_4','Logs')
print(log_path)

#  training an RL model 
env = gym.make(environment_name,render_mode="human")
env = DummyVecEnv([lambda: env])
model = PPO('MlpPolicy',env, verbose= 1, tensorboard_log=log_path)

# Setup callbacks for saving models and evaluating policy
checkpoint_callback = CheckpointCallback(save_freq=1000, save_path='./models/', name_prefix='ppo_cartpole')
eval_callback = EvalCallback(env, best_model_save_path='./logs/', log_path='./logs/', eval_freq=500, n_eval_episodes=5)

model.learn(total_timesteps=60000, callback=[checkpoint_callback, eval_callback])



# model.learn(total_timesteps=2000)


# saving the model 

PPO_Path = os.path.join('Training_4','Saved Models','PPO_Model_Cartpole')

